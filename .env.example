# Example environment variables for local development (copy to .env and set values)
# Switch storage implementation: local or s3
STORAGE_TYPE=local

# MinIO / S3 settings (used when STORAGE_TYPE=s3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sst-bucket
S3_ACCESS_KEY=miniouser
S3_SECRET_KEY=miniopassword
S3_PATH_STYLE=true

# Database (for docker-compose)
DB_URL=jdbc:postgresql://postgres:5432/sst_db?currentSchema=public
DB_USERNAME=postgres
DB_PASSWORD=12345

# Other
SERVER_PORT=8080
JWT_SECRET=replace-with-strong-secret
JWT_EXPIRATION=3600000
